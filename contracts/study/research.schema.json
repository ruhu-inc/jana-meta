{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://jana.dev/contracts/study/research",
 "title": "Study research agent",
 "description": "The research agent's conversation output, the brief the learner approves, and the gateway job that searches the web and fetches its sources (SPEC §18).",
 "$defs": {
  "ResearchId": {
   "type": "string",
   "pattern": "^rsj_[0-9A-HJKMNP-TV-Z]{26}$"
  },
  "Output": {
   "description": "What a study pack may contain: Study's own verified kinds, and the diagram drill on the learner's photo (SPEC §18.1).",
   "enum": [
    "diagram_drill",
    "concept_map",
    "notes",
    "flashcards",
    "quiz",
    "audio_overview"
   ]
  },
  "Brief": {
   "description": "The research plan the learner approved after talking it through (SPEC §18.1a). The job is built from these fields only, never from the conversation's text.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "subject",
    "level",
    "purpose",
    "known",
    "focus",
    "sub_questions",
    "outputs",
    "length"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 3,
     "maxLength": 120
    },
    "subject": {
     "enum": [
      "mathematics",
      "physics",
      "chemistry",
      "accounting",
      "biology"
     ]
    },
    "level": {
     "enum": [
      "o_level",
      "first_year"
     ]
    },
    "purpose": {
     "enum": [
      "exam",
      "lesson",
      "curiosity"
     ]
    },
    "known": {
     "type": "string",
     "minLength": 0,
     "maxLength": 300
    },
    "focus": {
     "type": "string",
     "minLength": 0,
     "maxLength": 300
    },
    "sub_questions": {
     "type": "array",
     "minItems": 4,
     "maxItems": 8,
     "items": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
     }
    },
    "outputs": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "uniqueItems": true,
     "items": {
      "$ref": "https://jana.dev/contracts/study/research#/$defs/Output"
     }
    },
    "length": {
     "description": "short: a 5-minute pack; long: a 20-minute pack.",
     "enum": [
      "short",
      "long"
     ]
    }
   }
  },
  "ChatTurn": {
   "description": "One step of the conversation before research (SPEC §18.1a), as the device's model call returns it: the next question with its quick replies, the finished brief, or a topic Jana does not research.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "question",
    "chips",
    "asks",
    "brief"
   ],
   "properties": {
    "kind": {
     "enum": [
      "question",
      "brief",
      "out_of_scope"
     ]
    },
    "question": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "minLength": 3,
       "maxLength": 200
      }
     ]
    },
    "chips": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
     }
    },
    "asks": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "enum": [
        "purpose",
        "known",
        "outputs"
       ]
      }
     ]
    },
    "brief": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "https://jana.dev/contracts/study/research#/$defs/Brief"
      }
     ]
    }
   }
  },
  "JobRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "brief",
    "photo_parts"
   ],
   "properties": {
    "brief": {
     "$ref": "https://jana.dev/contracts/study/research#/$defs/Brief"
    },
    "photo_parts": {
     "description": "The confirmed part names of the learner's photographed diagram, when the pack starts from one (the photo itself stays on the device).",
     "type": "array",
     "maxItems": 24,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     }
    }
   }
  },
  "Page": {
   "description": "One fetched source page, reduced to readable text by the gateway (SPEC §18.3 stage 3b).",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "url",
    "title",
    "site",
    "text",
    "sub_question",
    "fetched_at"
   ],
   "properties": {
    "url": {
     "type": "string",
     "pattern": "^https://",
     "maxLength": 2048
    },
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 160
    },
    "site": {
     "type": "string",
     "minLength": 1,
     "maxLength": 120
    },
    "text": {
     "type": "string",
     "minLength": 1,
     "maxLength": 60000
    },
    "sub_question": {
     "type": "integer",
     "minimum": 0,
     "maximum": 7
    },
    "fetched_at": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "SubQuestionProgress": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "text",
    "state",
    "sources"
   ],
   "properties": {
    "text": {
     "type": "string",
     "minLength": 8,
     "maxLength": 200
    },
    "state": {
     "enum": [
      "waiting",
      "searching",
      "fetching",
      "done",
      "failed"
     ]
    },
    "sources": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "Job": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "research_id",
    "status",
    "sub_questions",
    "failure",
    "pages",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "research_id": {
     "$ref": "https://jana.dev/contracts/study/research#/$defs/ResearchId"
    },
    "status": {
     "enum": [
      "queued",
      "researching",
      "ready",
      "failed",
      "cancelled"
     ]
    },
    "sub_questions": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "$ref": "https://jana.dev/contracts/study/research#/$defs/SubQuestionProgress"
     }
    },
    "failure": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "enum": [
        "no_sources",
        "budget",
        "interrupted",
        "upstream",
        "timeout"
       ]
      }
     ]
    },
    "pages": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "array",
       "maxItems": 30,
       "items": {
        "$ref": "https://jana.dev/contracts/study/research#/$defs/Page"
       }
      }
     ]
    },
    "created_at": {
     "type": "integer",
     "minimum": 0
    },
    "updated_at": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "RecordId": {
   "type": "string",
   "pattern": "^rsr_[0-9A-HJKMNP-TV-Z]{26}$"
  },
  "ChatEntry": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "role",
    "text",
    "asks"
   ],
   "properties": {
    "role": {
     "enum": [
      "jana",
      "learner"
     ]
    },
    "text": {
     "type": "string",
     "minLength": 1,
     "maxLength": 400
    },
    "asks": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "enum": [
        "purpose",
        "known",
        "outputs"
       ]
      }
     ]
    }
   }
  },
  "ChatRequest": {
   "description": "One turn of the conversation before research (SPEC §18.1a), as the app sends it: what the pack is about, the conversation so far (kept by the app), the learner's newest reply, or Skip.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "start",
    "history",
    "answer",
    "skip"
   ],
   "properties": {
    "start": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "topic"
       ],
       "properties": {
        "topic": {
         "type": "string",
         "minLength": 3,
         "maxLength": 200
        }
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "capture_id"
       ],
       "properties": {
        "capture_id": {
         "type": "string",
         "pattern": "^cap_[0-9A-HJKMNP-TV-Z]{26}$"
        }
       }
      }
     ]
    },
    "history": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "$ref": "https://jana.dev/contracts/study/research#/$defs/ChatEntry"
     }
    },
    "answer": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 400
      }
     ]
    },
    "skip": {
     "type": "boolean"
    }
   }
  },
  "CreateRequest": {
   "description": "Start research on an approved brief; with a capture, the pack also gets the diagram drill on that photo.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "brief",
    "capture_id"
   ],
   "properties": {
    "brief": {
     "$ref": "https://jana.dev/contracts/study/research#/$defs/Brief"
    },
    "capture_id": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "pattern": "^cap_[0-9A-HJKMNP-TV-Z]{26}$"
      }
     ]
    }
   }
  },
  "PackPart": {
   "description": "One Study job the pack started from the researched source, and the aid it made.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "job_id",
    "aid_id",
    "state"
   ],
   "properties": {
    "kind": {
     "enum": [
      "concept_map",
      "notes",
      "flashcards",
      "quiz",
      "audio_overview"
     ]
    },
    "job_id": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "https://jana.dev/contracts/study/workspace#/$defs/JobId"
      }
     ]
    },
    "aid_id": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "https://jana.dev/contracts/study/workspace#/$defs/AidId"
      }
     ]
    },
    "state": {
     "enum": [
      "waiting",
      "making",
      "ready",
      "failed"
     ]
    }
   }
  },
  "Record": {
   "description": "A study pack on the device: the approved brief, the research's progress, then the researched Study source and the parts made from it (SPEC §18.4).",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "research_id",
    "status",
    "brief",
    "capture_id",
    "sub_questions",
    "pages",
    "failure",
    "source_id",
    "parts",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "research_id": {
     "$ref": "https://jana.dev/contracts/study/research#/$defs/RecordId"
    },
    "status": {
     "enum": [
      "sending",
      "researching",
      "waiting_online",
      "making",
      "ready",
      "failed",
      "cancelled"
     ]
    },
    "brief": {
     "$ref": "https://jana.dev/contracts/study/research#/$defs/Brief"
    },
    "capture_id": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "pattern": "^cap_[0-9A-HJKMNP-TV-Z]{26}$"
      }
     ]
    },
    "sub_questions": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "$ref": "https://jana.dev/contracts/study/research#/$defs/SubQuestionProgress"
     }
    },
    "pages": {
     "type": "integer",
     "minimum": 0,
     "maximum": 30
    },
    "failure": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "enum": [
        "no_sources",
        "budget",
        "interrupted",
        "upstream",
        "timeout",
        "consent_required",
        "allowance_exhausted",
        "import_failed"
       ]
      }
     ]
    },
    "source_id": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "https://jana.dev/contracts/study/workspace#/$defs/SourceId"
      }
     ]
    },
    "parts": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "$ref": "https://jana.dev/contracts/study/research#/$defs/PackPart"
     }
    },
    "created_at": {
     "type": "integer",
     "minimum": 0
    },
    "updated_at": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "RecordList": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "items"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 200,
     "items": {
      "$ref": "https://jana.dev/contracts/study/research#/$defs/Record"
     }
    }
   }
  }
 }
}
