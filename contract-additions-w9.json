    {
      "target": "study/workspace.schema.json",
      "pointer": "/$defs/TeachingOutline",
      "requirements": [
        "§20.3",
        "JM-D33"
      ],
      "why": "The outline.",
      "value": {
        "description": "What a lecture teaches (SPEC §20.3, JM-D33): the model-written, cited part is objectives, examples, concepts and assumes, each citing a transcript line; the engine fills at_ms from the cited line, concepts[].kc_ids (engine/study_topics.py kc_tags over the concept's name and cited text, at most three), outside_packs when none, skips (skills of the tagged topics kc_tags over the whole transcript never tags) and for_you (the learner's bands, joined on the device). The gateway's structured output is the model part only; the request carries transcript chunks and nothing else.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectives",
          "examples",
          "concepts",
          "assumes"
        ],
        "properties": {
          "objectives": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "citations"
              ],
              "properties": {
                "citations": {
                  "type": "array",
                  "items": {
                    "$ref": "https://jana.dev/contracts/study/workspace#/$defs/Citation"
                  },
                  "minItems": 1,
                  "maxItems": 12
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "at_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7200000
                }
              }
            }
          },
          "examples": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "citations"
              ],
              "properties": {
                "citations": {
                  "type": "array",
                  "items": {
                    "$ref": "https://jana.dev/contracts/study/workspace#/$defs/Citation"
                  },
                  "minItems": 1,
                  "maxItems": 12
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "at_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7200000
                }
              }
            }
          },
          "concepts": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "citations"
              ],
              "properties": {
                "citations": {
                  "type": "array",
                  "items": {
                    "$ref": "https://jana.dev/contracts/study/workspace#/$defs/Citation"
                  },
                  "minItems": 1,
                  "maxItems": 12
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "kc_ids": {
                  "type": "array",
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^kc\\.(mth|phy|chm|bio|acc)\\.(o|a)\\.[a-z0-9_]+\\.[a-z0-9_]+$"
                  }
                },
                "outside_packs": {
                  "type": "boolean"
                },
                "at_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7200000
                }
              }
            }
          },
          "assumes": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "citations"
              ],
              "properties": {
                "citations": {
                  "type": "array",
                  "items": {
                    "$ref": "https://jana.dev/contracts/study/workspace#/$defs/Citation"
                  },
                  "minItems": 1,
                  "maxItems": 12
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          },
          "skips": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kc_id",
                "statement"
              ],
              "properties": {
                "kc_id": {
                  "type": "string",
                  "pattern": "^kc\\.(mth|phy|chm|bio|acc)\\.(o|a)\\.[a-z0-9_]+\\.[a-z0-9_]+$"
                },
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          },
          "for_you": {
            "type": "array",
            "maxItems": 48,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kc_id",
                "band"
              ],
              "properties": {
                "kc_id": {
                  "type": "string",
                  "pattern": "^kc\\.(mth|phy|chm|bio|acc)\\.(o|a)\\.[a-z0-9_]+\\.[a-z0-9_]+$"
                },
                "band": {
                  "enum": [
                    "not_started",
                    "learning",
                    "secure"
                  ]
                }
              }
            }
          }
        }
      }
    },
