{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the shell commands the UI invokes and nothing else (SEC-11). Window controls are the native title bar's.",
  "windows": ["main"],
  "permissions": [
    "allow-launch-info",
    "allow-pick-install-source",
    "allow-pick-profile-archive",
    "allow-update-recovery",
    "allow-rollback-update",
    "allow-checkin-permission",
    "allow-notify-checkin",
    "allow-cancel-checkins",
    "allow-take-checkin-click"
  ]
}
